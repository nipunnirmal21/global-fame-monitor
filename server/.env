# ========================================
# MongoDB Connection String
# ========================================
# 
# OPTION 1: Local MongoDB (requires MongoDB installed)
# MONGODB_URI=mongodb://localhost:27017/global-fame-monitor
#
# OPTION 2: MongoDB Atlas (FREE cloud database)
# 1. Go to https://www.mongodb.com/atlas
# 2. Create a free cluster
# 3. Get your connection string and replace below:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxxxx.mongodb.net/global-fame-monitor
#
# ========================================

# UNCOMMENT ONE OF THESE OR ADD YOUR OWN:
MONGODB_URI=mongodb://localhost:27017/global-fame-monitor

# JWT Secret (keep this secret in production!)
JWT_SECRET=gfm-secure-jwt-secret-2026-production-key

# Server port
PORT=5000
